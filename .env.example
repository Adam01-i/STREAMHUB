APP_ENV=development
APP_DEBUG=true
APP_NAME=StreamHub IPTV

DATABASE_URL=postgresql+asyncpg://streamhub:streamhub@localhost:5432/streamhub
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=14

IPTV_ORG_BASE_URL=https://iptv-org.github.io/api
IPTV_ORG_CHANNELS_URL=https://iptv-org.github.io/api/channels.json
IPTV_ORG_FEEDS_URL=https://iptv-org.github.io/api/feeds.json
IPTV_ORG_STREAMS_URL=https://iptv-org.github.io/api/streams.json
IPTV_ORG_LOGOS_URL=https://iptv-org.github.io/api/logos.json
IPTV_ORG_GUIDES_URL=https://iptv-org.github.io/api/guides.json
IPTV_ORG_CATEGORIES_URL=https://iptv-org.github.io/api/categories.json
IPTV_ORG_LANGUAGES_URL=https://iptv-org.github.io/api/languages.json
IPTV_ORG_COUNTRIES_URL=https://iptv-org.github.io/api/countries.json
IPTV_ORG_BLOCKLIST_URL=https://iptv-org.github.io/api/blocklist.json

CORS_ORIGINS=http://localhost:8000,http://localhost:3000


# Publicité (laisser vide = aucune publicité affichée)
AD_PROVIDER=none
ADSENSE_CLIENT_ID=
AD_SLOT_HOMEPAGE_TOP=
AD_SLOT_BETWEEN_SECTIONS=
AD_SLOT_CHANNEL_DETAIL=